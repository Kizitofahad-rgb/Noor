# Noor Application Environment Variables
# Port binding for Google Cloud Run (defaults to 8080 if omitted)
PORT=8080

# Node environment (production or development)
NODE_ENV=production

# Optional: YouTube Data API v3 key for querying external faith reminders
# (If omitted, Noor uses verified high-quality curated reminders)
YOUTUBE_API_KEY=

# Quran API endpoint (Free, open, keyless - NO API KEY OR AUTH REQUIRED)
QURAN_API_BASE=https://api.alquran.cloud/v1

# Audio streams freely from everyayah.com and mp3quran.net without API keys.
MP3QURAN_BASE=https://server8.mp3quran.net/afs

# Optional: Database Connection String
DATABASE_URL=
