# Noor Application Environment Variables
# Public recitation audio streams freely from everyayah.com and mp3quran.net without API keys.

# Optional: YouTube Data API key for querying external faith reminders
YOUTUBE_API_KEY=

# Optional: Custom Quran API endpoint overrides
QURAN_API_BASE=https://api.quran.com/api/v4
MP3QURAN_BASE=https://server8.mp3quran.net/afs
